{
  "expo": {
    "name": "RidersApp",
    "slug": "RidersApp",
    "scheme": "ridersapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.jpeg",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 2,
      "package": "com.ridersmx",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.jpeg",
        "monochromeImage": "./assets/android-icon-monochrome.jpeg"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icon.jpeg"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "RidersMX necesita acceder a tus fotos para usar una imagen de perfil o adjuntarla a tus reseñas.",
          "cameraPermission": "RidersMX necesita usar la cámara para tomar fotos de tus reseñas.",
          "microphonePermission": false,
          "colors": {
            "cropToolbarColor": "#3B82F6",
            "cropToolbarIconColor": "#FFFFFF",
            "cropToolbarActionTextColor": "#FFFFFF",
            "cropBackButtonIconColor": "#FFFFFF",
            "cropBackgroundColor": "#FFFFFF"
          },
          "dark": {
            "colors": {
              "cropToolbarColor": "#172033",
              "cropToolbarIconColor": "#FFFFFF",
              "cropToolbarActionTextColor": "#FFFFFF",
              "cropBackButtonIconColor": "#FFFFFF",
              "cropBackgroundColor": "#0F172A"
            }
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3B82F6"
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "b34a94d4-73dc-4f1f-985f-88e93965923c"
      }
    }
  }
}